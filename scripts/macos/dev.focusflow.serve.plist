<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Автозапуск "focus-flow serve" при входе в систему (launchd, macOS).
  Установка и команды: README.md, раздел "Автозапуск на macOS".
  __HOME__ заменяется на домашний каталог при установке (sed).
  Лог: ~/Library/Logs/focus-flow.log.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>dev.focusflow.serve</string>

  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/.cargo/bin/focus-flow</string>
    <string>serve</string>
  </array>

  <!-- Запуск при входе и перезапуск, если процесс упал (но не после штатной остановки). -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  <!-- Сервис интерактивный (уведомления), поэтому LaunchAgent, а не LaunchDaemon. -->
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>RUST_LOG</key>
    <string>info,rmcp=warn</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/focus-flow.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/focus-flow.log</string>
</dict>
</plist>
